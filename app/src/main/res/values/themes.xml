<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Platform theme only: all in-app styling comes from Compose (ZeltaTheme).
         No AppCompat/Material-Components dependency on purpose. -->
    <style name="Theme.ZeltaTV" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/zelta_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowActionModeOverlay">true</item>
    </style>
</resources>
